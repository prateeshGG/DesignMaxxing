{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": "cp landing/prototype/landing-v4.html landing/prototype/index.html",
  "outputDirectory": "landing/prototype",
  "headers": [
    {
      "source": "/(img|video)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
