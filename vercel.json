{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": null,
  "outputDirectory": "landing/prototype",
  "cleanUrls": true,
  "rewrites": [
    { "source": "/", "destination": "/landing-v4.html" }
  ],
  "headers": [
    {
      "source": "/(img|video)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
