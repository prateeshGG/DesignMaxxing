{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": null,
  "buildCommand": "rm -rf dist && mkdir -p dist && cp -R ../prototype/. dist/ && cp dist/landing-v4.html dist/index.html",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/(img|video)/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }]
    }
  ]
}
